- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: ADS-B live map.\nInput : message\
      \ port 'in'  (connect ADS-B Decoder 'decoded' here)\nOutput: http://localhost:<port>\
      \  (live map + table)\n\"\"\"\nimport csv\nimport json\nimport math\nimport\
      \ os\nimport threading\nimport time\nfrom http.server import BaseHTTPRequestHandler,\
      \ ThreadingHTTPServer\n\nimport pmt\nfrom gnuradio import gr\n\nPAGE = \"\"\"\
      <!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>ADS-B Live Map</title>\n\
      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link\
      \ rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"\
      >\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n\
      <style>\n html,body{margin:0;height:100%;font-family:system-ui,sans-serif}\n\
      \ #wrap{display:flex;height:100%}\n #map{flex:1}\n #side{width:340px;overflow:auto;background:#111;color:#eee;font-size:13px}\n\
      \ #side h3{margin:0;padding:10px;background:#222}\n table{width:100%;border-collapse:collapse}\n\
      \ th,td{padding:5px 6px;text-align:left;border-bottom:1px solid #333}\n tr:hover{background:#222;cursor:pointer}\n\
      \ .plane{background:none;border:none}\n</style></head>\n<body><div id=\"wrap\"\
      ><div id=\"map\"></div>\n<div id=\"side\"><h3>Aircraft: <span id=\"n\">0</span>\
      \ <span id=\"st\" style=\"font-weight:normal;font-size:11px\"></span></h3>\n\
      <table><thead><tr><th>Callsign</th><th>ICAO</th><th>Alt ft</th><th>kt</th></tr></thead>\n\
      <tbody id=\"rows\"></tbody></table></div></div>\n<script>\nvar map = L.map('map').setView([12.95,\
      \ 77.62], 9);\nL.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',\n\
      \  {maxZoom: 18, attribution: '&copy; OpenStreetMap'}).addTo(map);\nvar markers\
      \ = {}, trails = {}, fitted = false;\n\nfunction icon(h){\n  return L.divIcon({className:'plane',\
      \ iconSize:[28,28], iconAnchor:[14,14],\n    html:'<svg viewBox=\"0 0 24 24\"\
      \ width=\"28\" height=\"28\" style=\"transform:rotate('+h+'deg)\">'+\n    '<path\
      \ d=\"M12 2L15 10L22 14V16L15 14L14 20L16 22V23L12 22L8 23V22L10 20L9 14L2 16V14L9\
      \ 10Z\" '+\n    'fill=\"#e53\" stroke=\"#000\" stroke-width=\"1\"/></svg>'});\n\
      }\nfunction fmt(v){ return (v===null||v===undefined) ? '-' : Math.round(v);\
      \ }\n\nasync function tick(){\n  try{\n    var r = await fetch('/data'); var\
      \ data = await r.json();\n    var s = await (await fetch('/status')).json();\n\
      \    document.getElementById('st').textContent = ' | PDUs: ' + s.rx + (s.age\
      \ !== null ? ' | last ' + s.age + 's ago' : '');\n    var seen = {}, rows =\
      \ '', pts = [];\n    data.forEach(function(p){\n      seen[p.icao] = 1;\n  \
      \    var name = p.callsign || p.icao;\n      rows += '<tr onclick=\"goto(\\\\\
      ''+p.icao+'\\\\')\"><td>'+name+'</td><td>'+p.icao+\n              '</td><td>'+fmt(p.altitude)+'</td><td>'+fmt(p.speed)+'</td></tr>';\n\
      \      if(p.latitude===null || p.longitude===null) return;\n      var ll = [p.latitude,\
      \ p.longitude]; pts.push(ll);\n      var tip = '<b>'+name+'</b><br>ICAO '+p.icao+'<br>Alt\
      \ '+fmt(p.altitude)+' ft<br>'+\n                'Speed '+fmt(p.speed)+' kt<br>Hdg\
      \ '+fmt(p.heading)+'&deg;<br>'+\n                'Climb '+fmt(p.vertical_rate)+'\
      \ ft/min<br>SNR '+(p.snr?p.snr.toFixed(1):'-')+' dB';\n      if(markers[p.icao]){\n\
      \        markers[p.icao].setLatLng(ll).setIcon(icon(p.heading||0)).setPopupContent(tip);\n\
      \        trails[p.icao].setLatLngs(p.trail);\n      } else {\n        markers[p.icao]\
      \ = L.marker(ll, {icon: icon(p.heading||0)}).bindPopup(tip).addTo(map);\n  \
      \      trails[p.icao] = L.polyline(p.trail, {color:'#e53', weight:2}).addTo(map);\n\
      \      }\n    });\n    Object.keys(markers).forEach(function(k){\n      if(!seen[k]){\
      \ map.removeLayer(markers[k]); map.removeLayer(trails[k]);\n               \
      \     delete markers[k]; delete trails[k]; }\n    });\n    document.getElementById('rows').innerHTML\
      \ = rows;\n    document.getElementById('n').textContent = data.length;\n   \
      \ if(!fitted && pts.length){ map.fitBounds(pts, {maxZoom:11, padding:[40,40]});\
      \ fitted = true; }\n  }catch(e){ document.getElementById('st').textContent =\
      \ ' ERR: ' + e; }\n}\nfunction goto(i){ if(markers[i]){ map.setView(markers[i].getLatLng(),\
      \ 11); markers[i].openPopup(); } }\nsetInterval(tick, 1000); tick();\n</script></body></html>\n\
      \"\"\"\n\n\nclass _Server(ThreadingHTTPServer):\n    allow_reuse_address = False\
      \   # fail loudly if port is already taken\n    daemon_threads = True\n\n\n\
      class blk(gr.basic_block):\n    def __init__(self, port=8080, timeout_s=60):\n\
      \        gr.basic_block.__init__(self, name=\"ADSB Map\", in_sig=None, out_sig=None)\n\
      \        self.port = int(port)\n        self.timeout_s = float(timeout_s)\n\
      \        self.planes = {}\n        self.lock = threading.Lock()\n\n        #\
      \ CSV track log (appends; one row per new position update)\n        self.log_path\
      \ = os.path.abspath(\"adsb_tracks.csv\")\n        new_file = not os.path.exists(self.log_path)\n\
      \        self.log_f = open(self.log_path, \"a\", newline=\"\")\n        self.log_w\
      \ = csv.writer(self.log_f)\n        if new_file:\n            self.log_w.writerow([\"\
      t\", \"icao\", \"callsign\", \"lat\", \"lon\", \"altitude\",\n             \
      \                    \"speed\", \"heading\", \"vertical_rate\", \"snr\"])\n\
      \            self.log_f.flush()\n        print(\"ADSB Map: logging tracks to\
      \ %s\" % self.log_path)\n\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n\
      \        self._start_server()\n\n    # ---------- message handling ----------\n\
      \    def parse_meta(self, msg):\n        meta = pmt.car(msg) if pmt.is_pair(msg)\
      \ else msg\n        if not pmt.is_dict(meta):\n            return None\n   \
      \     d = {}\n        items = pmt.dict_items(meta)\n        for i in range(pmt.length(items)):\n\
      \            pair = pmt.nth(i, items)\n            k, v = pmt.car(pair), pmt.cdr(pair)\n\
      \            if not pmt.is_symbol(k):\n                continue\n          \
      \  key = pmt.symbol_to_string(k)\n            if pmt.is_symbol(v):\n       \
      \         d[key] = pmt.symbol_to_string(v)\n            elif pmt.is_real(v):\n\
      \                d[key] = pmt.to_double(v)\n            elif pmt.is_integer(v):\n\
      \                d[key] = pmt.to_long(v)\n            else:\n              \
      \  d[key] = None\n        return d\n\n    def handle_msg(self, msg):\n     \
      \   try:\n            meta = self.parse_meta(msg)\n        except Exception\
      \ as e:\n            print(\"ADSB Map: parse error: %r\" % (e,))\n         \
      \   return\n        if not meta:\n            print(\"ADSB Map: PDU has no metadata\
      \ dict\")\n            return\n        self.rx = getattr(self, \"rx\", 0) +\
      \ 1\n        self.last_rx = time.time()\n        if self.rx == 1 or self.rx\
      \ % 50 == 0:\n            print(\"ADSB Map: received %d PDUs, last icao=%s lat=%s\
      \ lon=%s\"\n                  % (self.rx, meta.get(\"icao\"), meta.get(\"latitude\"\
      ), meta.get(\"longitude\")))\n\n        icao = str(meta.get(\"icao\", \"\")).strip()\n\
      \        if not icao:\n            return\n\n        def num(key):\n       \
      \     try:\n                v = float(meta.get(key))\n                return\
      \ None if math.isnan(v) else v\n            except (TypeError, ValueError):\n\
      \                return None\n\n        cs = meta.get(\"callsign\")\n      \
      \  cs = cs.strip() if isinstance(cs, str) else \"\"\n        if cs.lower() ==\
      \ \"none\":\n            cs = \"\"\n\n        with self.lock:\n            p\
      \ = self.planes.setdefault(icao, {\n                \"icao\": icao, \"callsign\"\
      : \"\", \"latitude\": None, \"longitude\": None,\n                \"altitude\"\
      : None, \"speed\": None, \"heading\": None,\n                \"vertical_rate\"\
      : None, \"snr\": None, \"trail\": [],\n            })\n            if cs:\n\
      \                p[\"callsign\"] = cs\n            for k in (\"altitude\", \"\
      speed\", \"vertical_rate\", \"snr\"):\n                v = num(k)\n        \
      \        if v is not None:\n                    p[k] = v\n            hdg =\
      \ num(\"heading\")\n            if hdg is not None:\n                p[\"heading\"\
      ] = hdg % 360  # decoder gives -180..180\n\n            lat, lon = num(\"latitude\"\
      ), num(\"longitude\")\n            if lat is not None and lon is not None:\n\
      \                p[\"latitude\"], p[\"longitude\"] = lat, lon\n            \
      \    pt = [lat, lon]\n                if not p[\"trail\"] or p[\"trail\"][-1]\
      \ != pt:\n                    p[\"trail\"].append(pt)\n                    p[\"\
      trail\"] = p[\"trail\"][-60:]\n                    self.log_row(p)\n       \
      \     p[\"seen\"] = time.time()\n\n    def log_row(self, p):\n        try:\n\
      \            self.log_w.writerow([\n                \"%.3f\" % time.time(),\
      \ p[\"icao\"], p[\"callsign\"], p[\"latitude\"], p[\"longitude\"],\n       \
      \         \"\" if p[\"altitude\"] is None else p[\"altitude\"],\n          \
      \      \"\" if p[\"speed\"] is None else p[\"speed\"],\n                \"\"\
      \ if p[\"heading\"] is None else p[\"heading\"],\n                \"\" if p[\"\
      vertical_rate\"] is None else p[\"vertical_rate\"],\n                \"\" if\
      \ p[\"snr\"] is None else p[\"snr\"]])\n            self.log_f.flush()\n   \
      \     except Exception as e:\n            print(\"ADSB Map: log error: %r\"\
      \ % (e,))\n\n    def status(self):\n        rx = getattr(self, \"rx\", 0)\n\
      \        age = round(time.time() - self.last_rx, 1) if rx else None\n      \
      \  return {\"rx\": rx, \"age\": age}\n\n    def snapshot(self):\n        now\
      \ = time.time()\n        with self.lock:\n            for k in [k for k, p in\
      \ self.planes.items() if now - p[\"seen\"] > self.timeout_s]:\n            \
      \    del self.planes[k]\n            return [dict(p) for p in self.planes.values()]\n\
      \n    # ---------- web server ----------\n    def _start_server(self):\n   \
      \     outer = self\n\n        class Handler(BaseHTTPRequestHandler):\n     \
      \       def do_GET(self):\n                if self.path.startswith(\"/data\"\
      ):\n                    body = json.dumps(outer.snapshot()).encode()\n     \
      \               ctype = \"application/json\"\n                elif self.path.startswith(\"\
      /status\"):\n                    body = json.dumps(outer.status()).encode()\n\
      \                    ctype = \"application/json\"\n                else:\n \
      \                   body = PAGE.encode()\n                    ctype = \"text/html;\
      \ charset=utf-8\"\n                self.send_response(200)\n               \
      \ self.send_header(\"Content-Type\", ctype)\n                self.send_header(\"\
      Content-Length\", str(len(body)))\n                self.end_headers()\n    \
      \            self.wfile.write(body)\n\n            def log_message(self, *args):\n\
      \                pass\n\n        try:\n            self.server = _Server((\"\
      127.0.0.1\", self.port), Handler)\n        except OSError as e:\n          \
      \  print(\"ADSB Map: cannot start server on port %d: %s\" % (self.port, e))\n\
      \            return\n        threading.Thread(target=self.server.serve_forever,\
      \ daemon=True).start()\n        print(\"ADSB Map: open http://localhost:%d\"\
      \ % self.port)\n\n    def stop(self):\n        try:\n            self.server.shutdown()\n\
      \        except Exception:\n            pass\n        return True"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    port: '8080'
    timeout_s: '60'
  states:
    _io_cache: ('ADSB Map', 'blk', [('port', '8080'), ('timeout_s', '60')], [('in',
      'message', 1)], [], '', ['port', 'timeout_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [928, 144.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: ADS-B IQ burst capture for RF fingerprinting.\n\
      \nWire it like this (see ADSB_fingerprint.grc):\n    rtlsdr_source_0 : 0   \
      \   ->  this block : 0   (complex IQ, same stream the decoder chain uses)\n\
      \    adsb_framer_0   : 0      ->  this block : 1   (float; carries the framer's\
      \ \"burst\" tags)\n    adsb_decoder_0  : decoded ->  this block : decoded  (message\
      \ port)\n\nHow a burst gets its label\n    * The framer tags the first preamble\
      \ pulse of every candidate burst with (\"SOB\", snr).\n      That tag's offset\
      \ is an absolute sample index, so this block can cut the matching\n      IQ\
      \ window out of its own copy of the stream: [offset - pre, offset - pre + window).\n\
      \    * The decoder only publishes a 'decoded' message when the CRC check passed.\
      \ Its\n      metadata carries the same snr value (a double, copied unchanged\
      \ through demod and\n      decoder). Matching on that exact value pairs each\
      \ decoded ICAO with its IQ window.\n    * Bursts whose CRC failed never get\
      \ a label and are discarded, so every saved\n      burst is CRC-verified.\n\n\
      Output: shards  <out_dir>/iq_<session>_<nnnnn>.npz  with\n    iq (N, window,\
      \ 2) float16   I/Q, sample [:, pre] is the first preamble pulse\n    t (N,)\
      \ float64              UTC time from the demodulator\n    icao (N,) str    \
      \           CRC-verified ICAO address\n    df (N,) int16               downlink\
      \ format\n    snr (N,) float32            framer SNR estimate in dB\n    sample_offset\
      \ (N,) int64    absolute sample index of the burst start\n    pre, window, fs,\
      \ session    scalars\n\"\"\"\nimport os\nimport threading\nimport time\n\nimport\
      \ numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFRAME_SAMPLES_2MSPS =\
      \ 240  # 8 us preamble + 112 us data at 2 MS/s\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, out_dir=\"iq_bursts\", window=2400, pre=240, samp_rate=2e6,\n\
      \                 max_per_icao=3000, shard_size=500, min_snr_db=0.0):\n    \
      \    gr.sync_block.__init__(self, name=\"ADSB IQ Capture\",\n              \
      \                 in_sig=[np.complex64, np.float32], out_sig=None)\n       \
      \ self.out_dir = os.path.abspath(str(out_dir))\n        self.window = int(window)\n\
      \        self.pre = int(pre)\n        self.fs = float(samp_rate)\n        self.samp_rate\
      \ = self.fs\n        self.max_per_icao = int(max_per_icao)\n        self.shard_size\
      \ = int(shard_size)\n        self.min_snr_db = float(min_snr_db)\n        if\
      \ self.pre + FRAME_SAMPLES_2MSPS > self.window:\n            raise ValueError(\"\
      window must be at least pre + 240 samples\")\n        os.makedirs(self.out_dir,\
      \ exist_ok=True)\n\n        self.session = time.strftime(\"%Y%m%d-%H%M%S\")\n\
      \        self.lock = threading.Lock()\n\n        # sample ring buffer (own copy\
      \ of the IQ stream)\n        self.buf = np.zeros(0, dtype=np.complex64)\n  \
      \      self.buf0 = 0                      # absolute index of buf[0]\n     \
      \   self.pending = []                  # bursts whose window is not complete\
      \ yet\n        self.ready = {}                    # snr -> finished IQ window\
      \ waiting for its label\n        self.labels = {}                   # snr ->\
      \ decoded message waiting for its IQ window\n\n        # time-base consistency\
      \ check: decoded timestamp - offset/fs is constant\n        self.t_base = None\n\
      \        self.bad_streak = 0\n\n        self.rows = {k: [] for k in (\"iq\"\
      , \"t\", \"icao\", \"df\", \"snr\", \"off\")}\n        self.per_icao = {}\n\
      \        self.shard_idx = 0\n        self.last_flush = time.time()\n       \
      \ self.stats = dict(tags=0, saved=0, no_label=0, no_iq=0, mismatch=0, capped=0)\n\
      \n        self.message_port_register_in(pmt.intern(\"decoded\"))\n        self.set_msg_handler(pmt.intern(\"\
      decoded\"), self.handle_msg)\n        print(\"ADSB IQ Capture: writing shards\
      \ to %s (window=%d, pre=%d)\"\n              % (self.out_dir, self.window, self.pre))\n\
      \n    # ------------------------------------------------------------------ stream\
      \ side\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        n = len(x)\n        start = self.nitems_read(0)\n        end = start\
      \ + n\n\n        with self.lock:\n            if self.buf.size == 0:\n     \
      \           self.buf0 = start\n            self.buf = np.concatenate([self.buf,\
      \ x.astype(np.complex64, copy=False)])\n\n            for tag in self.get_tags_in_range(1,\
      \ start, end, pmt.intern(\"burst\")):\n                try:\n              \
      \      snr = float(pmt.to_python(tag.value)[1])\n                except Exception:\n\
      \                    continue\n                if not np.isfinite(snr) or snr\
      \ < self.min_snr_db:\n                    continue\n                self.stats[\"\
      tags\"] += 1\n                off = int(tag.offset)\n                self.pending.append({\"\
      off\": off, \"snr\": snr,\n                                     \"a\": off -\
      \ self.pre, \"b\": off - self.pre + self.window})\n\n            still = []\n\
      \            for p in self.pending:\n                if p[\"b\"] > end:\n  \
      \                  still.append(p)\n                    continue\n         \
      \       if p[\"a\"] < self.buf0:\n                    self.stats[\"no_iq\"]\
      \ += 1       # tag arrived after its samples were trimmed\n                \
      \    continue\n                seg = self.buf[p[\"a\"] - self.buf0: p[\"b\"\
      ] - self.buf0]\n                p[\"iq\"] = np.stack([seg.real, seg.imag], axis=-1).astype(np.float16)\n\
      \                p[\"created\"] = time.time()\n                self._pair_with_label(p)\n\
      \            self.pending = still\n\n            keep_from = min([p[\"a\"] for\
      \ p in self.pending] + [end - self.pre - 64])\n            cut = keep_from -\
      \ self.buf0\n            if cut > 0:\n                self.buf = self.buf[cut:]\n\
      \                self.buf0 = keep_from\n\n            self._expire()\n     \
      \       if time.time() - self.last_flush > 60:\n                self._flush()\n\
      \        return n\n\n    # ----------------------------------------------------------------\
      \ message side\n    def handle_msg(self, msg):\n        try:\n            meta\
      \ = pmt.to_python(pmt.car(msg))\n            snr = float(meta[\"snr\"])\n  \
      \          lab = {\"t\": float(meta[\"timestamp\"]), \"icao\": str(meta[\"icao\"\
      ]).strip(),\n                   \"df\": int(meta.get(\"df\", -1)), \"snr\":\
      \ snr, \"created\": time.time()}\n        except Exception:\n            return\n\
      \        if not lab[\"icao\"] or not np.isfinite(snr):\n            return\n\
      \        with self.lock:\n            p = self.ready.pop(snr, None)\n      \
      \      if p is None:\n                self.labels[snr] = lab\n            else:\n\
      \                self._commit(p, lab)\n\n    # -------------------------------------------------------------------\
      \ internals\n    def _pair_with_label(self, p):\n        lab = self.labels.pop(p[\"\
      snr\"], None)\n        if lab is None:\n            self.ready[p[\"snr\"]] =\
      \ p\n        else:\n            self._commit(p, lab)\n\n    def _commit(self,\
      \ p, lab):\n        base = lab[\"t\"] - p[\"off\"] / self.fs\n        if self.t_base\
      \ is None:\n            self.t_base = base\n        if abs(base - self.t_base)\
      \ > 2e-3:          # same snr value, wrong burst\n            self.stats[\"\
      mismatch\"] += 1\n            self.bad_streak += 1\n            if self.bad_streak\
      \ > 20:                # first match was the wrong one: re-learn\n         \
      \       self.t_base, self.bad_streak = None, 0\n            return\n       \
      \ self.bad_streak = 0\n        icao = lab[\"icao\"]\n        if self.per_icao.get(icao,\
      \ 0) >= self.max_per_icao:\n            self.stats[\"capped\"] += 1\n      \
      \      return\n        self.per_icao[icao] = self.per_icao.get(icao, 0) + 1\n\
      \        self.rows[\"iq\"].append(p[\"iq\"])\n        self.rows[\"t\"].append(lab[\"\
      t\"])\n        self.rows[\"icao\"].append(icao)\n        self.rows[\"df\"].append(lab[\"\
      df\"])\n        self.rows[\"snr\"].append(p[\"snr\"])\n        self.rows[\"\
      off\"].append(p[\"off\"])\n        self.stats[\"saved\"] += 1\n        if len(self.rows[\"\
      t\"]) >= self.shard_size:\n            self._flush()\n\n    def _expire(self,\
      \ max_age=10.0):\n        now = time.time()\n        for store, key in ((self.ready,\
      \ \"no_label\"), (self.labels, \"no_iq\")):\n            for k in [k for k,\
      \ v in store.items() if now - v[\"created\"] > max_age]:\n                del\
      \ store[k]\n                if key == \"no_label\":\n                    self.stats[key]\
      \ += 1       # CRC failed (or never decoded): expected, not an error\n\n   \
      \ def _flush(self):\n        self.last_flush = time.time()\n        if not self.rows[\"\
      t\"]:\n            return\n        path = os.path.join(self.out_dir, \"iq_%s_%05d.npz\"\
      \ % (self.session, self.shard_idx))\n        np.savez(path,\n              \
      \   iq=np.stack(self.rows[\"iq\"]),\n                 t=np.asarray(self.rows[\"\
      t\"], dtype=np.float64),\n                 icao=np.asarray(self.rows[\"icao\"\
      ], dtype=\"<U6\"),\n                 df=np.asarray(self.rows[\"df\"], dtype=np.int16),\n\
      \                 snr=np.asarray(self.rows[\"snr\"], dtype=np.float32),\n  \
      \               sample_offset=np.asarray(self.rows[\"off\"], dtype=np.int64),\n\
      \                 pre=self.pre, window=self.window, fs=self.fs, session=self.session)\n\
      \        print(\"ADSB IQ Capture: %s  (%d bursts) | %s\" % (os.path.basename(path),\
      \ len(self.rows[\"t\"]), self.stats))\n        self.shard_idx += 1\n       \
      \ self.rows = {k: [] for k in self.rows}\n\n    def stop(self):\n        with\
      \ self.lock:\n            self._flush()\n        return True\n"
    affinity: ''
    alias: ''
    comment: 'RF fingerprinting: cuts a labelled IQ window for every CRC-passed burst'
    max_per_icao: '3000'
    maxoutbuf: '0'
    min_snr_db: '0.0'
    minoutbuf: '0'
    out_dir: '"iq_bursts"'
    pre: '240'
    samp_rate: samp_rate
    shard_size: '500'
    window: '2400'
  states:
    _io_cache: ('ADSB IQ Capture', 'blk', [('out_dir', "'iq_bursts'"), ('window',
